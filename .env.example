# Copiá a .env (o dejá que el panel admin lo cree al desplegar). Nunca subas el .env al repo.
PORT=4870
# 127.0.0.1 = solo accesible desde este server (Cloudflare Tunnel apunta a http://localhost:4870)
HOST=127.0.0.1
# Clave para usar la API (mínimo 32 caracteres). Generala con: openssl rand -hex 32
RELAY_TOKEN=
# Pausa mínima entre consultas a Steam (ms) y cuánto esperar si Steam limita (ms)
STEAM_GAP_MS=1500
STEAM_PAUSE_MS=120000
